  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "rm -rf public/cesium && mkdir -p public/cesium && cp -R node_modules/cesium/Build/Cesium/Assets public/cesium && cp -R node_modules/cesium/Build/Cesium/Workers public/cesium && cp -R node_modules/cesium/Build/Cesium/Widgets public/cesium && cp -R node_modules/cesium/Build/Cesium/ThirdParty public/cesium",
